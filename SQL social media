-- Q1: How well does admin engage audience?
SELECT 
    a.admin_name,
    SUM(e.likes) AS total_likes,
    SUM(e.shares) AS total_shares,
    SUM(e.comments) AS total_comments,
    SUM(pv.visits) AS total_page_visits
FROM admin a
JOIN posts p ON a.admin_id = p.admin_id
JOIN engagement e ON p.post_id = e.post_id
JOIN page_visits pv ON a.admin_id = pv.admin_id
GROUP BY a.admin_name;

SELECT * FROM admin;
